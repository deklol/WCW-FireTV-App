{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WCW Chronology source configuration",
  "type": "object",
  "required": ["schemaVersion", "youtube", "archive"],
  "properties": {
    "schemaVersion": {"const": 1},
    "description": {"type": "string"},
    "youtube": {
      "type": "object",
      "required": ["channelId", "playlists"],
      "properties": {
        "enabled": {"type": "boolean"},
        "channelId": {"type": "string", "pattern": "^UC[A-Za-z0-9_-]{22}$"},
        "playlists": {"type": "array", "items": {"$ref": "#/$defs/playlist"}}
      }
    },
    "archive": {
      "type": "object",
      "required": ["collections"],
      "properties": {
        "enabled": {"type": "boolean"},
        "collectionsPerScan": {"type": "integer", "minimum": 1, "maximum": 50},
        "collections": {"type": "array", "items": {"$ref": "#/$defs/collection"}}
      }
    }
  },
  "$defs": {
    "show": {"enum": ["Nitro", "Thunder", "PPV", "Clash of the Champions", "Saturday Night", "Worldwide", "Pro"]},
    "playlist": {
      "type": "object", "required": ["id", "name", "show"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{10,80}$"},
        "name": {"type": "string"}, "enabled": {"type": "boolean"}, "show": {"$ref": "#/$defs/show"}
      }
    },
    "collection": {
      "type": "object", "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"},
        "name": {"type": "string"}, "enabled": {"type": "boolean"}, "showHint": {"$ref": "#/$defs/show"}
      }
    }
  }
}
